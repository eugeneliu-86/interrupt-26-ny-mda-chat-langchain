# Copy to .env.local and fill in. .env.local is gitignored.
#
# The Agent Server URL of the canonical deployment. Shared by every DE — you
# do NOT deploy your own.
MDA_API_URL=https://role-aware-docs-assistant-679d6573475f558188a07a13bc2b152c.us.langgraph.app

# YOUR OWN LangSmith API key, issued in the shared Demo workspace
# (a3866f07-2cf5-4e9c-a287-59ed817c2ecd). A personal key from another
# workspace returns 403, which reads like a broken URL.
#
# This is read ONLY by the server-side proxy. It has no NEXT_PUBLIC_ prefix
# and must never get one: that would ship your key to every browser.
LANGSMITH_API_KEY=

# The LangSmith project the deployment traces into. Not a secret — it is sent
# to the browser so the "view trace" link can be built from a run id.
LANGSMITH_PROJECT_URL=https://smith.langchain.com/o/a3866f07-2cf5-4e9c-a287-59ed817c2ecd/projects/p/28a396de-cca9-4594-b0ae-145a3ed6d686

# Compare mode ("Side by side" view) is ON unless this is false. It lets the
# browser choose each pane's role (validated against grants.json), so set it
# to false if you need the strict "the browser cannot set the role" property.
# DEMO_COMPARE_MODE=false
