# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# RESERVED platform variables: used for CLI auth and deploy routing, NOT
# uploaded as deployment secrets.
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=

# There is deliberately NO provider key here. The model routes through LLM
# Gateway (`langsmith:openai/gpt-5.6-luna`), which resolves the OpenAI
# credential from a workspace provider secret. See ph. 01 gate G3.

# LOCAL DEVELOPMENT ONLY. `connections.get("context-hub-corpus", ...)` resolves
# from this when running under `mda dev`, so the corpus tools work without a
# deploy round-trip. In the deployment the value comes from the connection.
# Use a workspace-scoped, READ-ONLY service key (lsv2_sk_…), never a PAT.
MDA_DEV_CONTEXT_HUB_CORPUS=
